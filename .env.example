# Gemini Developer API key from Google AI Studio
AI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
AI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Shared private token: same value in the Roblox Studio plugin and Render
BRIDGE_TOKEN=GENERATE_A_LONG_RANDOM_SECRET

# Roblox Open Cloud API key with creator-store-product:read scope
# This is separate from AI_API_KEY and is used only for Creator Store search.
ROBLOX_API_KEY=PASTE_YOUR_ROBLOX_CREATOR_STORE_API_KEY_HERE

# Private admin token for /givecredit and /setcredit commands
ADMIN_TOKEN=GENERATE_ANOTHER_LONG_RANDOM_SECRET

# Credit policy
STARTER_CREDITS=3
CREDIT_FLOOR=0.20
CREDIT_COST=0.05

# Only set this if you mounted a persistent Render disk at /var/data.
# Otherwise omit this line and the app stores data inside its local data/ folder,
# which can be cleared by a Render restart or redeploy.
# CREDITS_FILE=/var/data/credits.json

NODE_ENV=production
